# Used by local Python development. Docker Compose supplies its PostgreSQL URL.
CARHIBOU_DATABASE_URL=sqlite:///./carhibou.db

# Docker Compose image and host port.
CARHIBOU_IMAGE=ghcr.io/buco7854/carhibou:latest
CARHIBOU_PORT=8000
POSTGRES_PASSWORD=change-me

# Application settings.
CARHIBOU_ENVIRONMENT=development
CARHIBOU_PUBLIC_URL=http://localhost:8000
CARHIBOU_SESSION_COOKIE_SECURE=false
CARHIBOU_SESSION_PEPPER=replace-with-at-least-32-random-characters
CARHIBOU_MASTER_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
CARHIBOU_BOOTSTRAP_ADMIN_EMAIL=
CARHIBOU_BOOTSTRAP_ADMIN_PASSWORD=
CARHIBOU_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
CARHIBOU_LOG_LEVEL=INFO
