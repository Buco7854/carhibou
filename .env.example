# Used by local Python development. Docker Compose supplies its PostgreSQL URL.
VEHINODE_DATABASE_URL=sqlite:///./vehinode.db

# Docker Compose image and host port.
VEHINODE_IMAGE=ghcr.io/buco7854/vehinode:latest
VEHINODE_PORT=8000
POSTGRES_PASSWORD=change-me

# Application settings.
VEHINODE_ENVIRONMENT=development
VEHINODE_PUBLIC_URL=http://localhost:8000
VEHINODE_SESSION_COOKIE_SECURE=false
VEHINODE_SESSION_PEPPER=replace-with-at-least-32-random-characters
VEHINODE_MASTER_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
VEHINODE_BOOTSTRAP_ADMIN_EMAIL=
VEHINODE_BOOTSTRAP_ADMIN_PASSWORD=
VEHINODE_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
VEHINODE_LOG_LEVEL=INFO
